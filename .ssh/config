# SSH config
#
# Shared config lives here. Personal host definitions live in ~/.config/ssh.local.
#
# The AWS Session Manager helper comes from:
#   https://github.com/qoomon/aws-ssm-ssh-proxy-command
#
# bootstrap.sh will prompt on first install and will keep the helper up to date
# on subsequent runs if it is already present.

Include ~/.config/ssh.local

# AWS Session Manager hosts.
# Requires the aws-ssm-ssh-proxy-command helper under ~/.ssh/aws-ssm-ssh-proxy-command/.
Host i-* mi-*
    IdentityFile ~/.ssh/id_rsa
    ProxyCommand ~/.ssh/aws-ssm-ssh-proxy-command/aws-ssm-ssh-proxy-command.sh %h %r %p ~/.ssh/id_rsa.pub
    StrictHostKeyChecking no

# Support for multiplexed sessions
# Disable with "ControlMaster no" for specific hosts in ~/.config/ssh.local.
Host *
    ControlMaster auto
    ControlPath ~/.ssh/master/%r@%h:%p
    HostKeyAlgorithms=+ssh-rsa
